// SimpleIn Schools — Prisma Schema
// Provider: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  identifier         String       @unique
  passwordHash       String
  role               String       // "SUPER_ADMIN" | "SCHOOL_ADMIN" | "TEACHER" | "STUDENT" | "PARENT"
  roleLabel          String
  schoolId           String       @default("school-springfield-01")
  department         String?
  phone              String?
  status             String       @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "SUSPENDED"
  linkedChildIds     String[]     @default([])
  studentAdmissionNo String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions           Session[]
  auditEvents        AuditEvent[]

  @@index([schoolId, role, status])
  @@index([identifier])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorEmail  String?
  actorId     String?
  user        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  outcome     String   // "success" | "denied" | "error"
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorEmail])
  @@index([targetId])
}

model AdminCapacity {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  maxAdmins Int      @default(2)
  updatedAt DateTime @updatedAt
}
