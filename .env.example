# SimpleIn Schools — Environment Variables Configuration
# Copy this file to .env.local for local development

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a strong 32+ character random string for production
SESSION_SECRET=simplein_schools_secure_session_secret_change_in_production_2026
SESSION_MAX_AGE_SECONDS=604800

# Administrator Department Policy Scope
# Enforces maximum of TWO active administrator accounts
ADMIN_MAX_ACCOUNTS=2
ADMIN_POLICY_SCOPE=SCHOOL_TENANT

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Integration
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_[YOUR_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=sb_secret_[YOUR_SERVICE_ROLE_KEY]
